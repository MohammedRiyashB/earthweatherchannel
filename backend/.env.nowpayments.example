# NOWPayments secrets: add these in Render backend Environment, never in frontend .env
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Firebase Admin service-account JSON (one-line JSON string) for verified user auth and payment storage
FIREBASE_SERVICE_ACCOUNT_JSON=

# Exact public Render backend URL, e.g. https://earth-weather-api.onrender.com
PUBLIC_BACKEND_URL=
FRONTEND_PUBLIC_URL=https://earthweatherchannel.web.app

# Define real, approved subscription plans. Do not accept arbitrary prices from the browser.
# Example shape only; replace with your actual published plans/prices/durations.
EARTH_WEATHER_CRYPTO_PLANS={"starter_monthly":{"name":"Starter Monthly","price_amount":9.99,"price_currency":"usd","duration_days":30}}
