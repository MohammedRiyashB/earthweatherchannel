# NOWPayments secrets: Render backend Environment only; never expose in frontend or GitHub.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Firebase Admin service-account JSON as a single-line JSON string.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Public HTTPS URLs.
PUBLIC_BACKEND_URL=https://earthweather-api.onrender.com
FRONTEND_PUBLIC_URL=https://earthweatherchannel.web.app

# Fernet encryption key for customer API keys (generate once; keep stable; never rotate without re-encrypting stored keys).
EARTH_WEATHER_API_KEY_ENCRYPTION_KEY=

# Server-controlled service catalogue. Each key is the API service ID accepted by checkout.
# Each price_per_day is USD. Enter the real, approved service IDs and prices.
# Example schema only (do not paste sample prices as production prices):
# EARTH_WEATHER_API_SERVICES={"current-weather":{"name":"Current Weather API","price_per_day":0.4271,"requests_per_day":1000}}
EARTH_WEATHER_API_SERVICES=

# Existing named Cloud Firestore database ID (Firebase Console shows: earthweather).
CLOUD_FIRESTORE_DATABASE=earthweather
