# Primary weather provider — create a free key at https://www.weatherapi.com/
WEATHERAPI_KEY=

# Secondary weather provider — create a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Final fallback. Use a real contact URL/email and the actual site identity.
# MET Norway may reject generic or unidentified User-Agent values.
METNORWAY_USER_AGENT=EARTH-WEATHER/1.0 (contact: replace-with-real-project-contact)

# Set production frontend origin(s), comma-separated, before public deployment.
CORS_ORIGINS=https://earthweatherchannel.web.app,https://earthweatherchannel.firebaseapp.com,https://earth-weather-web.onrender.com,http://localhost:5173
