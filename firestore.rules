rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // EARTH WEATHER currently accesses Firestore only from the trusted
    // FastAPI backend through Firebase Admin SDK. The Admin SDK uses IAM
    // credentials and bypasses client Security Rules.
    //
    // Deployment verified for the named `earthweather` database.
    // Payment records, subscriptions, API-key hashes/encrypted secrets,
    // entitlements and quota counters are server-owned data.
    //
    // Any future direct browser access must add a narrowly-scoped rule for
    // a documented collection and test it with the Firebase Rules Emulator.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
